{
  "identifier": "app.tyrminal.desktop.e2e",
  "productName": "Tyrminal E2E",
  "app": {
    "security": {
      "capabilities": [
        "main",
        "detached",
        {
          "identifier": "e2e-automation",
          "description": "Test builds only: lets the embedded WebDriver server drive the main window and detached tab windows.",
          "windows": ["main", "detached-*"],
          "permissions": ["wdio-webdriver:default"]
        }
      ]
    }
  }
}
