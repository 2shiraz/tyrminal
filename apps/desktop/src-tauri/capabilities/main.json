{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The trusted main window. It may call the application commands and nothing else: no filesystem, shell, HTTP, process, clipboard or opener plugin is granted. Links open only through the validated link_open command.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-unlock-recovery",
    "allow-vault-lock",
    "allow-vault-change-passphrase",
    "allow-vault-rotate-recovery-key",
    "allow-vault-activity",
    "allow-vault-quick-unlock-status",
    "allow-vault-quick-unlock-enable",
    "allow-vault-quick-unlock-disable",
    "allow-vault-unlock-device",
    "allow-host-list",
    "allow-host-save",
    "allow-host-delete",
    "allow-key-list",
    "allow-key-import",
    "allow-key-generate",
    "allow-key-delete",
    "allow-key-deploy-preview",
    "allow-key-deploy",
    "allow-known-host-list",
    "allow-known-host-remove",
    "allow-group-list",
    "allow-group-save",
    "allow-group-delete",
    "allow-host-search",
    "allow-host-duplicate",
    "allow-host-bulk",
    "allow-import-preview",
    "allow-import-hosts",
    "allow-session-open-ssh",
    "allow-session-open-local",
    "allow-session-write",
    "allow-session-resize",
    "allow-session-ack",
    "allow-session-close",
    "allow-session-trust-answer",
    "allow-session-auth-answer",
    "allow-files-pick-upload",
    "allow-files-pick-folder",
    "allow-files-pick-upload-folder",
    "allow-files-list",
    "allow-files-mkdir",
    "allow-files-rename",
    "allow-files-remove",
    "allow-files-chmod",
    "allow-files-upload",
    "allow-files-download",
    "allow-files-cancel",
    "allow-files-local-list",
    "allow-files-edit-open",
    "allow-files-edit-status",
    "allow-files-edit-save",
    "allow-files-edit-close",
    "allow-snippet-list",
    "allow-snippet-save",
    "allow-snippet-delete",
    "allow-snippet-send",
