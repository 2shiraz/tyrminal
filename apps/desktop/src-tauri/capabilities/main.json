{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The trusted main window. It may call the application commands and nothing else: no filesystem, shell, HTTP, process, clipboard or opener plugin is granted.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-unlock-recovery",
    "allow-vault-lock",
    "allow-vault-change-passphrase",
    "allow-vault-rotate-recovery-key",
    "allow-host-list",
    "allow-host-save",
    "allow-host-delete",
    "allow-key-list",
    "allow-key-import",
    "allow-key-generate",
    "allow-key-delete",
    "allow-known-host-list",
    "allow-known-host-remove",
    "allow-session-open-ssh",
    "allow-session-open-local",
    "allow-session-write",
    "allow-session-resize",
    "allow-session-ack",
    "allow-session-close",
    "allow-session-trust-answer",
    "allow-session-auth-answer"
  ]
}
