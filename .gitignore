# Build output
/target/
**/target/
node_modules/
dist/
*.tsbuildinfo
apps/desktop/src-tauri/gen/schemas/

# Test/lab runtime state (generated keys, sockets, logs). Never commit.
tests/ssh-lab/.run/
tests/ssh-lab/.run-*/
.lab/
*.log
coverage/
playwright-report/
test-results/

# Local evidence that may hold machine-specific data
docs/reports/raw/
# Redesign captures are regenerated by tests/ui/redesign-capture.ts and tests/native/redesign.test.mjs
docs/redesign/before/
docs/redesign/after/
docs/redesign/native/
docs/redesign/capture-results/
docs/redesign/focused-a11y/
docs/redesign/*-results.json

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.p12
*.key
!tests/fixtures/**/*.pub

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Fuzzing state
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
