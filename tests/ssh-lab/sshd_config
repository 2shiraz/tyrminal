# Tyrminal lab sshd. Host keys, authorized keys and the password are generated per run by scripts/lab.mjs.
Port 22
AddressFamily any
ListenAddress 0.0.0.0
ListenAddress ::

HostKey /etc/ssh/lab/ssh_host_ed25519_key
HostKey /etc/ssh/lab/ssh_host_rsa_key

PermitRootLogin no
AllowUsers tyr noforward nosession
PasswordAuthentication yes
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile /etc/ssh/lab/authorized_keys
# Per-run lab CA (user certificates, KEY-07).
TrustedUserCAKeys /etc/ssh/lab/trusted_user_ca
StrictModes yes
MaxAuthTries 6
MaxStartups 200:30:400
MaxSessions 64
LoginGraceTime 30

# Lab only: every test client reaches the container from one NAT address and the suite
# deliberately fails and abandons authentication, which would trip OpenSSH's per-source
# penalties (9.8+) and drop unrelated tests. Never copy this line to a real server.
PerSourcePenalties no

AllowTcpForwarding yes
GatewayPorts no
X11Forwarding no
AllowAgentForwarding yes
PermitUserEnvironment no
AcceptEnv TYR_*
PrintMotd no
Subsystem sftp internal-sftp

# VERBOSE logs key fingerprints and auth attempts; tests read these to prove ordering (INV-02).
LogLevel VERBOSE

Match User noforward
    AllowTcpForwarding no
    PermitOpen none

# Authenticates, but every session channel open is refused (denied-channel fixture).
Match User nosession
    MaxSessions 0
