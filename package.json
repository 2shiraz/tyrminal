{
  "name": "tyrminal",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "docs:check": "node scripts/feature-matrix.mjs --check",
    "lab:up": "node scripts/lab.mjs up",
    "lab:down": "node scripts/lab.mjs down",
    "contracts": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "dev": "pnpm --filter @tyrminal/desktop tauri dev",
    "build:desktop": "pnpm --filter @tyrminal/desktop tauri build",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:native": "node scripts/verify.mjs native",
    "verify:fast": "node scripts/verify.mjs fast",
    "test:integration": "node scripts/verify.mjs integration",
    "test:transfer": "node scripts/verify.mjs transfer",
    "test:security": "node scripts/verify.mjs security",
    "check:release": "node scripts/check-release.mjs",
    "test:ui": "pnpm --filter @tyrminal/desktop build && pnpm --filter @tyrminal/ui-tests test",
    "test:ui:update": "pnpm --filter @tyrminal/desktop build && pnpm --filter @tyrminal/ui-tests update",
    "test:ui:container": "node scripts/ui-container.mjs",
    "test:ui:update:container": "node scripts/ui-container.mjs --update",
    "check:contrast": "node scripts/check-contrast.mjs",
    "dev:exp": "node scripts/exp/run.mjs dev",
    "build:exp": "node scripts/exp/run.mjs build",
    "build:web:exp": "node scripts/exp/run.mjs web",
    "test:ui:exp": "node scripts/exp/run.mjs test",
    "capture:exp": "node scripts/exp/run.mjs capture",
    "check:contrast:exp": "node scripts/exp/check-contrast.mjs"
  }
}
